# Copy to .env.local (git-ignored) and fill in real values.
# Get a key at https://home.openweathermap.org/api_keys

# Tile/metadata API key. Also used for geocoding (search + point-query reverse lookup).
# Without this, the demo shows an in-page error instead of a map.
VITE_OWM_API_KEY=

# Separate credential for the real-time lightning websocket (not the tile appid).
# Optional — the lightning overlay is simply skipped if unset.
VITE_OWM_LIGHTNING_API_KEY=
